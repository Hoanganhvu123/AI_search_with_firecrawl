# ==============================================================================
# FIRECRAWL AI SEARCH - ENVIRONMENT CONFIGURATION
# ==============================================================================
# WARNING: NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# THIS IS AN EXAMPLE FILE. COPY THIS TO .env AND REPLACE WITH YOUR ACTUAL KEYS.
# ==============================================================================

# 1. API Keys (Do not commit real keys!)
FIRECRAWL_API_KEY=fc-test-key-replace-me
OPENAI_API_KEY=sk-test-key-replace-me

# 2. FreeLLMAPI Proxy Configuration
# If you are using FreeLLMAPI, set the base URL here.
# Default is http://localhost:3001/v1
FRELLMAPI_BASE_URL=http://localhost:3001/v1
FRELLMAPI_KEY=freellmapi-test-key-replace-me

# 3. Server Configuration
PORT=5000
ENVIRONMENT=development # Set to 'production' for deployment
